{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "../dist/types",
    "rootDir": "..",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"],
      "next/link": ["./ds-entry/shims/link.tsx"],
      "next/navigation": ["./ds-entry/shims/navigation.tsx"]
    }
  },
  "include": ["./ds-entry/index.ts"]
}
