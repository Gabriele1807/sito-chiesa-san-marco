# Copia in .env.local per lo sviluppo. Su Vercel imposta le stesse variabili in
# Project → Settings → Environment Variables (vedi VERCEL_DEPLOYMENT_GUIDE.md).
# Non inserire mai valori reali in questo file: è tracciato da Git.

# ── Obbligatorie ────────────────────────────────────────────────────────────
# MongoDB: contenuti, utenti, sessioni, iscrizioni. Senza, l'app e la build
# ("Collecting page data") falliscono subito con un errore esplicito.
MONGODB_URI=
# Nome del database (default nel codice: chiesa_san_marco)
MONGODB_DB=
# Firma HMAC dei JWT di sessione (utenti e admin) e dei cookie OAuth.
# Stringa casuale lunga (es. `openssl rand -base64 48`). Cambiarla disconnette tutti.
ADMIN_SESSION_SECRET=
# Supabase: account amministratore (tabella admin_users). Service role = solo server.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# URL pubblico esatto del sito, senza slash finale (es. https://www.dominio.it).
# Base di link email e redirect_uri OAuth. È incorporata al momento della build:
# dopo averla cambiata serve un nuovo deploy. In produzione, se manca, OAuth e
# reset password vengono disattivati con un errore nei log (nessun fallback).
NEXT_PUBLIC_SITE_URL=

# ── Consigliate in produzione ───────────────────────────────────────────────
# Redis (Upstash): rate limiting e revoca sessioni admin condivisi tra istanze.
# Senza, restano per singola istanza serverless (avviso nei log in produzione).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Nomi alternativi creati dall'integrazione Vercel Marketplace (basta una coppia)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Email transazionali — reset password (Resend).
# Senza RESEND_API_KEY la richiesta risponde comunque in modo generico ma l'email
# non parte (log "provider_not_configured"). In produzione EMAIL_FROM_AUTH è
# obbligatoria (indirizzo di un dominio verificato su Resend): il mittente di
# prova onboarding@resend.dev è usato solo in sviluppo.
RESEND_API_KEY=
EMAIL_FROM_AUTH=
EMAIL_REPLY_TO=
# Validità link di reset in minuti (5–60, default 60)
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=60

# ── Opzionali ───────────────────────────────────────────────────────────────
# Login/registrazione con Google e Facebook. Se una coppia manca, quel provider
# risulta "non disponibile" (messaggio all'utente, nessun crash).
# Callback da registrare sui portali provider:
#   ${NEXT_PUBLIC_SITE_URL}/api/auth/oauth/google/callback
#   ${NEXT_PUBLIC_SITE_URL}/api/auth/oauth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# YouTube Data API: ultimi video/diretta in home. Senza, viene mostrato un
# segnaposto con link al canale.
YOUTUBE_API_KEY=

# ── Predisposte ma non usate dal codice attuale ─────────────────────────────
# Modulo Brevo (eventi/newsletter) non collegato a nessun flusso: non servono.
BREVO_API_KEY=
EMAIL_FROM_EVENTS=
EMAIL_FROM_NEWSLETTER=
# Client Supabase lato browser non importato da nessuna parte: non serve.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
